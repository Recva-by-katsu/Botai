# ===== Telegram =====
# Token bot dari @BotFather (wajib)
TELEGRAM_BOT_TOKEN=

# ===== KATSU AI =====
# API key KATSU AI (wajib)
KATSU_API_KEY=
KATSU_BASE_URL=https://ai.katsuvip.eu.cc
# Default memakai Authorization: Bearer <key>. Jika server memakai X-API-Key, ubah ini.
KATSU_AUTH_HEADER=Authorization
# Model bawaan; pengguna bisa mengganti lewat /model
KATSU_MODEL=auto
# Kreativitas jawaban (0–2). 0.3 fokus, 0.7 seimbang, 1.0 kreatif
TEMPERATURE=0.7
# Batas token keluaran per jawaban (kosong = tanpa batas)
# MAX_TOKENS=2048
# Streaming jawaban bertahap seperti ChatGPT (true/false)
STREAM_ENABLED=true
# Batas tunggu API per permintaan (detik)
API_TIMEOUT_SECONDS=90
# Jeda minimum penyuntingan pratinjau streaming (milidetik, jaga di atas 2000 agar aman rate limit Telegram)
EDIT_INTERVAL_MS=2500

# ===== Perilaku bot =====
# Instruksi dasar AI
SYSTEM_PROMPT=Anda adalah KATSU AI, asisten pribadi yang cerdas, ramah, dan efisien di Telegram. Jawab sesuai bahasa pengguna (bawaan: Indonesia). Gunakan Markdown agar jawaban mudah dibaca: **teks tebal** untuk poin penting, daftar untuk langkah, dan blok kode dengan nama bahasa untuk kode. Jawab langsung ke inti tanpa basa-basi panjang. Jika pertanyaan kurang jelas, ajukan satu klarifikasi singkat.
# Jumlah pasangan tanya-jawab yang diingat (maksimal 50)
HISTORY_TURNS=10
# Panjang maksimum pertanyaan (karakter)
MAX_QUESTION_LENGTH=4000
# Kosong = semua pengguna boleh mengakses. Disarankan isi ID Telegram Anda.
ALLOWED_USER_IDS=
# Pembatas laju per pengguna
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# Batas sesi di memori dan masa berlaku (menit)
MAX_SESSIONS=500
SESSION_TTL_MINUTES=60
